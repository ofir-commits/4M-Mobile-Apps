{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns = section.settings.columns | default: 3
  assign feature_first = section.settings.feature_first
  assign default_title = 'sections.collection_list.default_title' | t

  assign tile_count = section.blocks.size

  comment
    No blocks yet (fresh insert in the theme editor): fall back to the
    store's own collections so the grid is never empty. Handles are
    captured first because the `collections` drop is keyed, not indexed.
  endcomment
  unless tile_count > 0
    capture fallback_handles
      for c in collections limit: 6
        echo c.handle
        unless forloop.last
          echo ','
        endunless
      endfor
    endcapture
    assign fallback_list = fallback_handles | split: ','
    assign tile_count = fallback_list.size
  endunless

  assign heading_id = 'CollectionListHeading-' | append: section.id
-%}

<section
  id="CollectionList-{{ section.id }}"
  class="section collection-list{% if section.settings.alt_background %} section--alt{% endif %}"
  {% if section.settings.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.show_view_all -%}
      <div class="section-header">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-header__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>

        {%- if section.settings.show_view_all -%}
          <a href="{{ routes.collections_url }}" class="section-header__link">
            {{ 'sections.collection_list.view_all' | t }}
            {% render 'icon', name: 'arrow-right', size: 18, class: 'icon--dir' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if tile_count > 0 -%}
      <div class="grid collection-list__grid" style="--cl-columns: {{ columns }};">
        {%- for i in (1..tile_count) -%}
          {%- liquid
            assign idx = forloop.index0
            assign attrs = ''

            if section.blocks.size > 0
              assign blk = section.blocks[idx]
              assign c = blk.settings.collection
              assign tile_title = blk.settings.title | default: c.title
              assign tile_image = blk.settings.image | default: c.featured_image
              assign attrs = blk.shopify_attributes
            else
              assign fallback_handle = fallback_list[idx]
              assign c = collections[fallback_handle]
              assign tile_title = c.title
              assign tile_image = c.featured_image
            endif

            assign is_feature = false
            if feature_first and forloop.first
              assign is_feature = true
            endif

            assign ph_index = idx | modulo: 6 | plus: 1
            assign ph_name = 'collection-' | append: ph_index
          -%}
          <div
            class="collection-list__item reveal{% if is_feature %} collection-list__item--feature{% endif %}"
            {{ attrs }}
          >
            {%- if c != blank -%}
              <a href="{{ c.url }}" class="collection-tile">
            {%- else -%}
              <div class="collection-tile">
            {%- endif -%}

            <div class="media collection-tile__media">
              {%- if tile_image != blank -%}
                <img
                  src="{{ tile_image | image_url: width: 900 }}"
                  srcset="{{ tile_image | image_url: width: 400 }} 400w, {{ tile_image | image_url: width: 600 }} 600w, {{ tile_image | image_url: width: 900 }} 900w, {{ tile_image | image_url: width: 1400 }} 1400w"
                  sizes="{% if is_feature %}(min-width: 750px) 66vw, 100vw{% else %}(min-width: 750px) 33vw, 50vw{% endif %}"
                  alt=""
                  loading="lazy"
                  width="{{ tile_image.width }}"
                  height="{{ tile_image.height }}"
                >
              {%- else -%}
                {{ ph_name | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="collection-tile__body">
              <div class="collection-list__tile-text">
                <h3 class="collection-tile__title">{{ tile_title | default: default_title | escape }}</h3>
                {%- if c != blank -%}
                  <span class="collection-tile__count">
                    {{- 'products.facets.product_count' | t: count: c.all_products_count -}}
                  </span>
                {%- endif -%}
              </div>
              {%- if c != blank -%}
                <span class="collection-tile__arrow" aria-hidden="true">
                  {% render 'icon', name: 'arrow-right', size: 20, class: 'icon--dir' %}
                </span>
              {%- endif -%}
            </div>

            {%- if c != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "רשימת קטגוריות",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "כותרת"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "מחלקות החנות"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "קונים לפי מחלקה"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "הצגת קישור \"לכל הקטגוריות\"",
      "default": true
    },
    {
      "type": "header",
      "content": "פריסה"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "עמודות במחשב",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "הבלטת האריח הראשון",
      "info": "האריח הראשון יתפרש על שתי עמודות עם תמונה גדולה יותר.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "רקע אפור בהיר",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "קטגוריה",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "קטגוריה"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "תמונה מותאמת (אופציונלי)",
          "info": "אם לא נבחרה - תוצג תמונת הקטגוריה."
        },
        {
          "type": "text",
          "id": "title",
          "label": "כותרת מותאמת (אופציונלי)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "רשימת קטגוריות",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
