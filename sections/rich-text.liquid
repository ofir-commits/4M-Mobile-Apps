<section
  id="RichText-{{ section.id }}"
  class="section{% if section.settings.alt_background %} section--alt{% endif %}"
>
  <div class="container {% if section.settings.width == 'narrow' %}container--text{% else %}container--narrow{% endif %}">
    <div class="rich-text-block">
      <span class="rich-text-block__rule blueprint-rule reveal" aria-hidden="true"></span>

      {%- if section.settings.eyebrow != blank -%}
        <span class="text-eyebrow reveal">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="rich-text-block__heading reveal">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rich-text-block__text rte reveal">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="btn btn--outline rich-text-block__btn reveal" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  #RichText-{{ section.id }} .rich-text-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
  }

  /* Short centred blueprint mark opens the block. */
  #RichText-{{ section.id }} .rich-text-block__rule {
    flex: none;
    inline-size: 64px;
    margin-block-end: 0.35rem;
  }

  /* The eyebrow's leading dash would fight the centred rule above it. */
  #RichText-{{ section.id }} .text-eyebrow { margin-block-end: 0; }
  #RichText-{{ section.id }} .text-eyebrow::before { display: none; }

  #RichText-{{ section.id }} .rich-text-block__heading {
    margin: 0;
    text-wrap: balance;
  }

  #RichText-{{ section.id }} .rich-text-block__text {
    max-inline-size: 68ch;
    color: var(--color-text);
  }

  #RichText-{{ section.id }} .rich-text-block__btn { margin-block-start: 0.6rem; }
{% endstyle %}

{% schema %}
{
  "name": "טקסט עשיר",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "מי אנחנו"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "יותר מ־30 שנה של מקצועיות, אמינות ושירות"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "טקסט",
      "default": "<p>א.נ. שילו בע\"מ הוא הבית של אנשי המקצוע: חנות חומרי בניין, מחלקת אספקה טכנית ומחסן עצים, הכל במתחם אחד בקיבוץ קרית ענבים. אצלנו תמצאו את המותגים המובילים בעולם, מחירים הוגנים וצוות שמכיר כל מוצר מהשטח.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "טקסט כפתור (אופציונלי)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "קישור כפתור"
    },
    {
      "type": "select",
      "id": "width",
      "label": "רוחב התוכן",
      "options": [
        { "value": "narrow", "label": "צר" },
        { "value": "normal", "label": "רגיל" }
      ],
      "default": "normal"
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "רקע אפור בהיר",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "טקסט עשיר"
    }
  ]
}
{% endschema %}
