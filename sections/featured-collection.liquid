{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_limit | default: 10
  assign columns = section.settings.columns | default: 5

  assign has_products = false
  if coll != blank and coll.products.size > 0
    assign has_products = true
  endif

  assign product_count = 0
  if coll != blank
    assign product_count = coll.all_products_count
  endif

  assign view_all_url = coll.url | default: routes.all_products_collection_url

  comment
    The row carries both .scroll-row and .grid/.grid--N from base.css.
    section-featured-collection.css picks the winner per breakpoint:
    rail under 750px, grid above - or rail everywhere with --rail.
  endcomment
  assign row_class = 'featured-collection__row scroll-row grid grid--' | append: columns
  if section.settings.scroll_desktop
    assign row_class = row_class | append: ' featured-collection__row--rail'
  endif

  assign heading_id = 'FeaturedCollectionHeading-' | append: section.id
-%}

<section
  id="FeaturedCollection-{{ section.id }}"
  class="section featured-collection{% if section.settings.highlight %} featured-collection--highlight{% elsif section.settings.alt_background %} section--alt{% endif %}"
  {% if section.settings.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-header__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}

        <div class="featured-collection__title-row">
          {%- if section.settings.heading != blank -%}
            <h2 class="section-header__heading" id="{{ heading_id }}">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if product_count > 0 -%}
            <span class="badge badge--outline featured-collection__count">
              {{- 'products.facets.product_count' | t: count: product_count -}}
            </span>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_view_all -%}
        <a href="{{ view_all_url }}" class="section-header__link">
          {{ 'sections.featured_collection.view_all' | t }}
          {% render 'icon', name: 'arrow-right', size: 18, class: 'icon--dir' %}
        </a>
      {%- endif -%}
    </div>

    <div class="{{ row_class }}" style="--fc-columns: {{ columns }};">
      {%- if has_products -%}
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, lazy: true, class: 'reveal', sizes: '(min-width: 1400px) 260px, (min-width: 1100px) 20vw, (min-width: 750px) 30vw, min(70vw, 265px)' %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          {% render 'product-card', placeholder_index: forloop.index, class: 'reveal' %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "קולקציה מומלצת",
  "settings": [
    {
      "type": "header",
      "content": "כותרת"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "הבחירה של המקצוענים"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "הנמכרים ביותר"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "הצגת קישור \"לכל המוצרים\"",
      "default": true
    },
    {
      "type": "header",
      "content": "מוצרים"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "קולקציה",
      "info": "כשלא נבחרה קולקציה, או כשהיא ריקה, יוצגו כרטיסי דוגמה."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "מספר מוצרים מקסימלי",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 10
    },
    {
      "type": "header",
      "content": "פריסה"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "עמודות במחשב",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "scroll_desktop",
      "label": "גלילה אופקית גם במחשב",
      "info": "במובייל המוצרים תמיד מוצגים בשורה נגללת.",
      "default": false
    },
    {
      "type": "header",
      "content": "עיצוב"
    },
    {
      "type": "checkbox",
      "id": "highlight",
      "label": "רצועת מבצע (רקע ענבר עדין)",
      "info": "מדגיש את הרצועה בגוון ענבר רך - מתאים למבצעים ולמכירות מיוחדות.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "alt_background",
      "label": "רקע אפור בהיר",
      "info": "לא פעיל כשמסומנת רצועת מבצע.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "קולקציה מומלצת"
    }
  ]
}
{% endschema %}
