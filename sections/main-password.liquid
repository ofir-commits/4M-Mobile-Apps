{{ 'section-password.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Coming-soon screen. Ink canvas + blueprint grid (section--ink supplies both),
  the logo on a white plate so it reads on the dark field, and the real store
  contact details — a locked storefront should still be reachable by phone.
{%- endcomment -%}
<div class="password-page section--ink">
  <div class="password-page__inner">
    {%- if settings.logo != blank -%}
      {%- assign logo_width = settings.logo_width | default: 260 -%}
      {%- assign logo_width_2x = logo_width | times: 2 -%}
      {%- assign logo_height = logo_width | divided_by: settings.logo.aspect_ratio | round -%}
      <span class="password-page__logo-plate">
        <img
          class="password-page__logo"
          src="{{ settings.logo | image_url: width: logo_width_2x }}"
          alt="{{ shop.name | escape }}"
          width="{{ logo_width }}"
          height="{{ logo_height }}"
          loading="eager"
          fetchpriority="high"
        >
      </span>
    {%- else -%}
      <span class="password-page__shopname">{{ shop.name }}</span>
    {%- endif -%}

    <div class="password-page__head">
      <h1 class="password-page__title">{{ 'general.password_page.title' | t }}</h1>
      <p class="password-page__subtitle">{{ 'general.password_page.subtitle' | t }}</p>
    </div>

    <div class="panel password-page__card">
      <div class="password-page__card-head">
        {% render 'icon', name: 'shield-check', size: 20 %}
        <h2 class="h4 password-page__card-title">{{ 'general.password_page.login_form_heading' | t }}</h2>
      </div>

      {%- form 'storefront_password', class: 'password-page__form' -%}
        {%- if form.errors -%}
          <div class="errors" role="alert" tabindex="-1">
            <ul role="list">
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="StorefrontPassword">
            {{ 'general.password_page.login_form_password_label' | t }}
          </label>
          <input
            class="field__input"
            type="password"
            id="StorefrontPassword"
            name="password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
        </div>

        <button type="submit" class="btn btn--full">
          {{ 'general.password_page.login_form_submit' | t }}
        </button>

        {%- if section.settings.note != blank -%}
          <p class="password-page__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="password-page__contact">
      <ul class="password-page__contact-list" role="list">
        {%- if settings.store_phone != blank -%}
          <li>
            <a class="password-page__contact-item" href="tel:{{ settings.store_phone | remove: '-' | remove: ' ' }}">
              {% render 'icon', name: 'phone', size: 17 %}
              <span class="password-page__ltr">{{ settings.store_phone }}</span>
            </a>
          </li>
        {%- endif -%}
        {%- if settings.store_whatsapp != blank -%}
          <li>
            <a
              class="password-page__contact-item"
              href="{{ settings.store_whatsapp }}"
              target="_blank"
              rel="noopener"
            >
              {% render 'icon', name: 'whatsapp', size: 17 %}
              {{ 'general.social.whatsapp' | t }}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.store_email != blank -%}
          <li>
            <a class="password-page__contact-item" href="mailto:{{ settings.store_email }}">
              {% render 'icon', name: 'mail', size: 17 %}
              <span class="password-page__ltr">{{ settings.store_email }}</span>
            </a>
          </li>
        {%- endif -%}
      </ul>

      <div class="password-page__meta">
        {%- if settings.store_address != blank -%}
          <span class="password-page__meta-row">
            {% render 'icon', name: 'map-pin', size: 15 %}
            <span>{{ settings.store_address }}</span>
          </span>
        {%- endif -%}
        {%- if settings.store_hours != blank -%}
          <span class="password-page__meta-row">
            {% render 'icon', name: 'clock', size: 15 %}
            <span>{{ settings.store_hours | newline_to_br }}</span>
          </span>
        {%- endif -%}
      </div>
    </div>

    <footer class="password-page__footer">
      <p>{{ 'general.password_page.admin_link_html' | t }}</p>
    </footer>
  </div>
</div>

{% schema %}
{
  "name": "עמוד סיסמה",
  "settings": [
    {
      "type": "text",
      "id": "note",
      "label": "הערה מתחת לכפתור",
      "default": "קיבלתם סיסמה מאיתנו? הזינו אותה כאן כדי להיכנס לחנות."
    }
  ]
}
{% endschema %}
