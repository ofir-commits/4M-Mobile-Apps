{{ 'section-blog.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Blog index: one optional wide card for the newest guide, then a card grid.
  Tag chips filter in place; every card comes from snippets/article-card.liquid.
{%- endcomment -%}

<div class="blog-index">
  <header class="blog-header">
    <div class="container">
      {%- if settings.show_breadcrumbs -%}
        <nav class="breadcrumbs blog-header__crumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
          <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
          <span class="breadcrumbs__sep" aria-hidden="true">
            {% render 'icon', name: 'chevron-right', size: 14, class: 'icon--dir' %}
          </span>
          {%- if current_tags != blank -%}
            <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
            <span class="breadcrumbs__sep" aria-hidden="true">
              {% render 'icon', name: 'chevron-right', size: 14, class: 'icon--dir' %}
            </span>
            <span class="breadcrumbs__current" aria-current="page">{{ current_tags | join: ', ' }}</span>
          {%- else -%}
            <span class="breadcrumbs__current" aria-current="page">{{ blog.title | escape }}</span>
          {%- endif -%}
        </nav>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <span class="text-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}

      <h1 class="blog-header__heading blueprint-underline">{{ blog.title | escape }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="blog-header__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_tag_filter and blog.all_tags.size > 0 -%}
        <nav class="blog-tags" aria-label="{{ 'blog.article.tags' | t }}">
          <a
            href="{{ blog.url }}"
            class="chip{% if current_tags == blank %} chip--active{% endif %}"
            {% if current_tags == blank %}aria-current="true"{% endif %}
          >{{ 'blog.general.all_posts' | t }}</a>
          {%- for tag in blog.all_tags -%}
            {%- if current_tags contains tag -%}
              <a
                href="{{ blog.url }}"
                class="chip chip--active"
                aria-current="true"
                title="{{ 'general.search.clear' | t }}"
              >
                {{ tag | escape }}
                {% render 'icon', name: 'close', size: 14 %}
              </a>
            {%- else -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="chip">{{ tag | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </header>

  {% paginate blog.articles by 12 %}
    <div class="container blog-articles">
      {%- if blog.articles.size > 0 -%}
        {%- liquid
          assign show_featured = false
          if section.settings.show_featured and paginate.current_page == 1 and current_tags == blank
            assign show_featured = true
          endif

          assign grid_count = blog.articles.size
          if show_featured
            assign grid_count = grid_count | minus: 1
          endif
        -%}

        {%- if show_featured -%}
          {% render 'article-card', article: blog.articles.first, featured: true, class: 'reveal' %}
        {%- endif -%}

        {%- if grid_count > 0 -%}
          <ul class="grid grid--3 blog-grid" role="list">
            {%- for article in blog.articles -%}
              {%- if show_featured and forloop.first -%}{%- continue -%}{%- endif -%}
              <li>
                {% render 'article-card', article: article, lazy: true, class: 'reveal' %}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {% render 'pagination', paginate: paginate %}
      {%- elsif request.design_mode -%}
        {%- comment -%} Onboarding preview in the theme editor while the blog is still empty {%- endcomment -%}
        {% render 'article-card', article: blank, featured: true %}
        <ul class="grid grid--3 blog-grid" role="list">
          {%- for i in (1..3) -%}
            <li>{% render 'article-card', article: blank, lazy: true %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="panel blog-empty">
          <div class="empty-state">
            {% render 'icon', name: 'clipboard', size: 44 %}
            {%- if current_tags != blank -%}
              <h2 class="empty-state__title h3">{{ 'blog.general.empty_tag' | t }}</h2>
              <p class="empty-state__text">{{ 'blog.general.empty_tag_hint' | t }}</p>
              <a href="{{ blog.url }}" class="btn btn--outline">{{ 'blog.general.all_posts' | t }}</a>
            {%- else -%}
              <h2 class="empty-state__title h3">{{ 'blog.general.empty' | t }}</h2>
              <p class="empty-state__text">{{ 'blog.general.empty_hint' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn">
                {{ 'general.error_404.button' | t }}
                {% render 'icon', name: 'arrow-right', size: 16, class: 'icon--dir' %}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "עמוד בלוג",
  "settings": [
    {
      "type": "header",
      "content": "כותרת עליונה"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "שורת פתיחה קטנה",
      "default": "טיפים ומדריכים"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "משפט תיאור",
      "default": "מדריכים מקצועיים, השוואות והמלצות מצוות המומחים שלנו - כדי שתבחרו נכון כבר בפעם הראשונה."
    },
    {
      "type": "header",
      "content": "תצוגה"
    },
    {
      "type": "checkbox",
      "id": "show_tag_filter",
      "label": "הצגת סינון לפי תגיות",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_featured",
      "label": "הבלטת הכתבה האחרונה בכרטיס רחב",
      "default": true
    }
  ]
}
{% endschema %}
