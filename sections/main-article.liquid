{{ 'section-article.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-article.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Article: hero, one reading column at .container--text measure, share row,
  prev/next cards, then the comment thread on the alternate surface.
{%- endcomment -%}
{%- liquid
  assign share_url = shop.url | append: article.url
  assign share_text = article.title | append: ' - ' | append: share_url
  assign published_date = article.published_at | date: format: 'month_day_year'
-%}

<article class="article-page">
  {%- if section.settings.show_hero and article.image -%}
    <div class="article-hero container">
      <div class="media article-hero__media">
        <img
          src="{{ article.image | image_url: width: 1600 }}"
          srcset="
            {{ article.image | image_url: width: 800 }} 800w,
            {{ article.image | image_url: width: 1200 }} 1200w,
            {{ article.image | image_url: width: 1600 }} 1600w,
            {{ article.image | image_url: width: 2200 }} 2200w
          "
          sizes="(min-width: 1440px) 1376px, calc(100vw - 2rem)"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      </div>
    </div>
  {%- endif -%}

  <header class="article-header container container--text">
    {%- if settings.show_breadcrumbs -%}
      <nav class="breadcrumbs article-header__crumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span class="breadcrumbs__sep" aria-hidden="true">
          {% render 'icon', name: 'chevron-right', size: 14, class: 'icon--dir' %}
        </span>
        <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
        <span class="breadcrumbs__sep" aria-hidden="true">
          {% render 'icon', name: 'chevron-right', size: 14, class: 'icon--dir' %}
        </span>
        <span class="breadcrumbs__current" aria-current="page">{{ article.title | escape }}</span>
      </nav>
    {%- endif -%}

    <div class="article-header__meta">
      <span class="article-header__meta-item">
        {% render 'icon', name: 'clock', size: 16 %}
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ 'blog.article.published_on' | t: date: published_date }}
        </time>
      </span>
      <span class="article-header__meta-item">
        {% render 'icon', name: 'user', size: 16 %}
        {{ 'blog.article.written_by' | t: author: article.author }}
      </span>
      {%- if blog.comments_enabled? -%}
        <a class="article-header__meta-item article-header__comments-link" href="#Comments">
          {{ 'blog.article.comments' | t: count: article.comments_count }}
        </a>
      {%- endif -%}
    </div>

    <h1 class="article-header__title">{{ article.title | escape }}</h1>
  </header>

  <div class="article-body container container--text">
    <div class="rte">
      {{ article.content }}
    </div>
  </div>

  {%- assign show_tags_row = false -%}
  {%- if section.settings.show_tags and article.tags.size > 0 -%}
    {%- assign show_tags_row = true -%}
  {%- endif -%}

  {%- if show_tags_row or section.settings.show_share -%}
    <div class="article-footer container container--text">
      {%- if show_tags_row -%}
        <div class="article-tags">
          <span class="article-tags__label">
            {% render 'icon', name: 'tag', size: 16 %}
            {{ 'blog.article.tags' | t }}
          </span>
          {%- for tag in article.tags -%}
            <a class="chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_share -%}
        <div class="article-share">
          <span class="article-share__label">{{ 'blog.article.share' | t }}</span>
          <div class="article-share__buttons">
            <button
              type="button"
              class="share-btn"
              data-copy-link="{{ share_url }}"
              data-copy-success="{{ 'general.share.copied' | t | escape }}"
              aria-label="{{ 'general.share.copy_link' | t }}"
              title="{{ 'general.share.copy_link' | t }}"
            >
              {% render 'icon', name: 'share', size: 18 %}
            </button>
            <a
              class="share-btn"
              href="https://wa.me/?text={{ share_text | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-label="{{ 'general.social.whatsapp' | t }}"
              aria-describedby="a11y-new-window-message"
              title="{{ 'general.social.whatsapp' | t }}"
            >
              {% render 'icon', name: 'whatsapp', size: 18 %}
            </a>
            <a
              class="share-btn"
              href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}"
              target="_blank"
              rel="noopener"
              aria-label="{{ 'general.social.facebook' | t }}"
              aria-describedby="a11y-new-window-message"
              title="{{ 'general.social.facebook' | t }}"
            >
              {% render 'icon', name: 'facebook', size: 18 %}
            </a>
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_prev_next -%}
    {%- liquid
      assign prev_article = blog.previous_article
      assign next_article = blog.next_article
      assign prev_url = prev_article.url | default: prev_article
      assign next_url = next_article.url | default: next_article
    -%}
    {%- if prev_url != blank or next_url != blank -%}
      <nav class="article-nav container container--text" aria-label="{{ 'blog.general.title' | t }}">
        {%- if prev_url != blank -%}
          <a href="{{ prev_url }}" class="card article-nav__link article-nav__link--prev">
            <span class="article-nav__label">
              {% render 'icon', name: 'chevron-right', size: 16, class: 'icon--dir' %}
              {{ 'blog.article.previous_article' | t }}
            </span>
            {%- if prev_article.title -%}
              <span class="article-nav__title">{{ prev_article.title | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- if next_url != blank -%}
          <a href="{{ next_url }}" class="card article-nav__link article-nav__link--next">
            <span class="article-nav__label">
              {{ 'blog.article.next_article' | t }}
              {% render 'icon', name: 'chevron-left', size: 16, class: 'icon--dir' %}
            </span>
            {%- if next_article.title -%}
              <span class="article-nav__title">{{ next_article.title | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endif -%}

  {%- if blog.comments_enabled? -%}
    <div class="article-comments-wrap" id="Comments">
      <div class="container container--text article-comments">
        {%- if article.comments_count > 0 -%}
          <h2 class="article-comments__title h3">
            {{ 'blog.article.comments' | t: count: article.comments_count }}
          </h2>

          {% paginate article.comments by 20 %}
            <ol class="article-comments__list" role="list">
              {%- for comment in article.comments -%}
                <li class="card comment-card">
                  <div class="comment-card__head">
                    <span class="comment-card__author">
                      <span class="comment-card__avatar" aria-hidden="true">
                        {% render 'icon', name: 'user', size: 15 %}
                      </span>
                      {{ comment.author | escape }}
                    </span>
                    <time class="comment-card__date" datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{ comment.created_at | date: format: 'month_day_year' }}
                    </time>
                  </div>
                  <div class="comment-card__body">{{ comment.content }}</div>
                </li>
              {%- endfor -%}
            </ol>
            {% render 'pagination', paginate: paginate %}
          {% endpaginate %}
        {%- else -%}
          <p class="article-comments__empty text-muted">{{ 'blog.article.no_comments' | t }}</p>
        {%- endif -%}

        {% form 'new_comment', article, class: 'panel comment-form', id: 'CommentForm' %}
          <h3 class="comment-form__title h4">{{ 'blog.article.comment_form_title' | t }}</h3>

          {%- if form.posted_successfully? -%}
            <div class="form__success" role="status" tabindex="-1">
              {% render 'icon', name: 'check-circle', size: 20 %}
              {%- if blog.moderated? -%}
                {{ 'blog.article.success_moderated' | t }}
              {%- else -%}
                {{ 'blog.article.success' | t }}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="errors" role="alert">
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form__row">
            <div class="field">
              <label class="field__label" for="CommentAuthor">
                {{ 'blog.article.name' | t }} <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                class="field__input"
                type="text"
                name="comment[author]"
                id="CommentAuthor"
                value="{{ form.author }}"
                autocomplete="name"
                required
              >
            </div>
            <div class="field">
              <label class="field__label" for="CommentEmail">
                {{ 'blog.article.email' | t }} <span class="required" aria-hidden="true">*</span>
              </label>
              <input
                class="field__input"
                type="email"
                name="comment[email]"
                id="CommentEmail"
                value="{{ form.email }}"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                dir="ltr"
                required
              >
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="CommentBody">
              {{ 'blog.article.message' | t }} <span class="required" aria-hidden="true">*</span>
            </label>
            <textarea
              class="field__textarea"
              name="comment[body]"
              id="CommentBody"
              rows="5"
              required
            >{{ form.body }}</textarea>
          </div>

          {%- if blog.moderated? -%}
            <p class="comment-form__note fs-sm text-muted">
              {% render 'icon', name: 'info', size: 16 %}
              {{ 'blog.article.moderated' | t }}
            </p>
          {%- endif -%}

          <button type="submit" class="btn btn--secondary comment-form__submit">
            {{ 'blog.article.post' | t }}
          </button>
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "עמוד כתבה",
  "settings": [
    {
      "type": "header",
      "content": "תצוגה"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "הצגת תמונה ראשית",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "הצגת תגיות",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "הצגת כפתורי שיתוף",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_prev_next",
      "label": "ניווט לכתבה הקודמת ולכתבה הבאה",
      "default": true
    }
  ]
}
{% endschema %}
