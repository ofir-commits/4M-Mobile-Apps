{{ 'section-customers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-customers.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Login + "forgot password" on one screen: two panels inside the same shell,
  swapped by section-customers.js (no page reload, :target fallback without JS).
  The recover form is captured first so its posted/error state can decide which
  panel opens on load.
{%- endcomment -%}
{%- liquid
  assign show_recover = false
  assign recover_success = false

  assign logo_width = settings.logo_width | default: 260
  assign logo_width_2x = logo_width | times: 2
  assign phone_href = settings.store_phone | remove: '-' | remove: ' ' | remove: '(' | remove: ')'
-%}

{%- capture recover_form_html -%}
  {%- form 'recover_customer_password', class: 'customer-form' -%}
    {%- if form.posted_successfully? -%}
      {%- assign recover_success = true -%}
    {%- endif -%}
    {%- if form.errors -%}
      {%- assign show_recover = true -%}
      <div class="errors" role="alert" tabindex="-1">
        <ul>
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] }} - {{ form.errors.messages[field] }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="RecoverEmail">
        {{ 'customer.recover_password.email' | t }} <span class="required" aria-hidden="true">*</span>
      </label>
      <input
        class="field__input"
        type="email"
        id="RecoverEmail"
        name="email"
        value=""
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        dir="ltr"
        required
        {% if form.errors %}aria-invalid="true"{% endif %}
      >
    </div>

    <button type="submit" class="btn btn--full auth-submit">
      {{ 'customer.recover_password.submit' | t }}
    </button>

    <div class="auth-meta auth-meta--center">
      <a class="link" href="#login" data-auth-show="login">{{ 'customer.recover_password.cancel' | t }}</a>
    </div>
  {%- endform -%}
{%- endcapture -%}

<section class="section auth-section">
  <div class="container">
    <div
      class="auth-shell"
      data-auth-panels
      data-active-panel="{% if show_recover %}recover{% else %}login{% endif %}"
    >
      <a class="auth-brand" href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          <img
            class="auth-brand__img"
            src="{{ settings.logo | image_url: width: logo_width_2x }}"
            srcset="{{ settings.logo | image_url: width: logo_width }} 1x, {{ settings.logo | image_url: width: logo_width_2x }} 2x"
            width="{{ logo_width }}"
            height="{{ logo_width | divided_by: settings.logo.aspect_ratio | round }}"
            alt="{{ settings.logo.alt | default: shop.name | escape }}"
            loading="eager"
          >
        {%- else -%}
          <span class="auth-brand__text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      {%- # ---------- Recover password panel ---------- -%}
      <div class="panel auth-card auth-panel--recover" data-auth-panel="recover" id="recover">
        <header class="auth-card__head">
          <span class="auth-card__icon" aria-hidden="true">{% render 'icon', name: 'mail', size: 24 %}</span>
          <h2 class="auth-card__title h2">{{ 'customer.recover_password.title' | t }}</h2>
          <p class="auth-card__subtext">{{ 'customer.recover_password.subtext' | t }}</p>
        </header>
        {{ recover_form_html }}
      </div>

      {%- # ---------- Login panel ---------- -%}
      <div class="panel auth-card auth-panel--login" data-auth-panel="login" id="login">
        <header class="auth-card__head">
          <span class="auth-card__icon" aria-hidden="true">{% render 'icon', name: 'user', size: 24 %}</span>
          <h1 class="auth-card__title h2">{{ 'customer.login_page.title' | t }}</h1>
          {%- if section.settings.login_subtext != blank -%}
            <p class="auth-card__subtext">{{ section.settings.login_subtext | escape }}</p>
          {%- endif -%}
        </header>

        {%- if recover_success -%}
          <div class="form__success" role="status" tabindex="-1">
            {% render 'icon', name: 'check-circle', size: 20 %}
            {{ 'customer.recover_password.success' | t }}
          </div>
        {%- endif -%}

        {%- form 'customer_login', class: 'customer-form', novalidate: 'novalidate' -%}
          {%- if form.errors -%}
            <div class="errors" role="alert" tabindex="-1">
              <ul>
                {%- for field in form.errors -%}
                  <li>
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }} - {{ form.errors.messages[field] }}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="field">
            <label class="field__label" for="LoginEmail">
              {{ 'customer.login_page.email' | t }} <span class="required" aria-hidden="true">*</span>
            </label>
            <input
              class="field__input"
              type="email"
              id="LoginEmail"
              name="customer[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              dir="ltr"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="field">
            <label class="field__label" for="LoginPassword">
              {{ 'customer.login_page.password' | t }} <span class="required" aria-hidden="true">*</span>
            </label>
            <input
              class="field__input"
              type="password"
              id="LoginPassword"
              name="customer[password]"
              autocomplete="current-password"
              required
              {% if form.errors %}aria-invalid="true"{% endif %}
            >
          </div>

          <div class="auth-meta">
            <a class="link" href="#recover" data-auth-show="recover">
              {{ 'customer.login_page.forgot_password' | t }}
            </a>
          </div>

          <button type="submit" class="btn btn--full auth-submit">
            {{ 'customer.login_page.sign_in' | t }}
          </button>
        {%- endform -%}

        <div class="auth-divider" aria-hidden="true">
          {{ 'customer.login_page.or' | t }}
        </div>

        <div class="auth-alt">
          <a class="btn btn--outline btn--full" href="{{ routes.account_register_url }}">
            {{ 'customer.login_page.create_account' | t }}
          </a>

          {%- if shop.checkout.guest_login -%}
            <div class="auth-guest">
              <h2 class="auth-guest__title">{{ 'customer.login_page.guest_title' | t }}</h2>
              {%- form 'guest_login' -%}
                <button type="submit" class="btn btn--ghost btn--full">
                  {{ 'customer.login_page.guest_continue' | t }}
                  {% render 'icon', name: 'arrow-right', size: 16, class: 'icon--dir' %}
                </button>
              {%- endform -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.support_text != blank and settings.store_phone != blank -%}
        <div class="auth-support">
          <p class="auth-support__text">{{ section.settings.support_text | escape }}</p>
          <a class="auth-support__link" href="tel:{{ phone_href }}">
            {% render 'icon', name: 'phone', size: 16 %}
            <span class="auth-support__ltr">{{ settings.store_phone }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "התחברות",
  "settings": [
    {
      "type": "text",
      "id": "login_subtext",
      "label": "משפט מתחת לכותרת",
      "default": "התחברו כדי לצפות בהזמנות, במחירים ובכתובות השמורות שלכם."
    },
    {
      "type": "header",
      "content": "שורת תמיכה"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "טקסט",
      "info": "מוצג מתחת לכרטיס יחד עם מספר הטלפון מהגדרות התבנית. השאירו ריק כדי להסתיר.",
      "default": "נתקעתם בהתחברות? נשמח לעזור:"
    }
  ]
}
{% endschema %}
