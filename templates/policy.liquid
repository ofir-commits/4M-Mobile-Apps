{{ 'section-page.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shopify's policy pages (/policies/*) are the four documents a shopper reaches
  from the footer. The theme shipped without this template, so Shopify fell back
  to printing policy.content on its own: no container, no reading measure, no
  breadcrumbs — a full-bleed wall of text at whatever width the viewport happened
  to be. This gives them the same reading column as sections/main-page.liquid.

  Policies cannot be JSON templates and take no sections, so the markup lives
  here, deliberately mirroring main-page's structure and class names so the two
  page types stay visually identical.

  The heading does NOT use policy.title: these policies were left on their
  English admin defaults ("Refund policy", "Terms of service"), which would print
  English headings on a Hebrew page. Same locale-by-handle mapping the footer and
  snippets/legal-nav.liquid use, with policy.title kept as the fallback so a
  policy type this theme has not seen still renders something sensible.
{%- endcomment -%}
{%- liquid
  assign policy_handle = policy.url | split: '/' | last
  case policy_handle
    when 'refund-policy'
      assign policy_label = 'sections.footer.policies.refund' | t
    when 'shipping-policy'
      assign policy_label = 'sections.footer.policies.shipping' | t
    when 'privacy-policy'
      assign policy_label = 'sections.footer.policies.privacy' | t
    when 'terms-of-service'
      assign policy_label = 'sections.footer.policies.terms' | t
    when 'contact-information'
      assign policy_label = 'sections.footer.policies.contact' | t
    when 'subscription-policy'
      assign policy_label = 'sections.footer.policies.subscription' | t
    when 'legal-notice'
      assign policy_label = 'sections.footer.policies.legal' | t
    else
      assign policy_label = policy.title
  endcase
-%}

<section class="section main-page main-page--policy">
  <div class="container container--text">
    {%- if settings.show_breadcrumbs -%}
      <nav class="breadcrumbs main-page__crumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span class="breadcrumbs__sep" aria-hidden="true">
          {% render 'icon', name: 'chevron-right', size: 14, class: 'icon--dir' %}
        </span>
        <span class="breadcrumbs__current" aria-current="page">{{ policy_label | escape }}</span>
      </nav>
    {%- endif -%}

    <header class="main-page__head">
      <h1 class="main-page__title blueprint-underline">{{ policy_label | escape }}</h1>
      <p class="main-page__lead">{{ 'general.legal.lead' | t }}</p>
    </header>

    <div class="main-page__content">
      <div class="rte rte--legal">
        {{ policy.content }}
      </div>
    </div>

    {%- comment -%}
      The cross-links sit AFTER the document, not before it: a visitor arrives to
      read one specific policy, and a row of sibling links above the text would
      only push what they came for below the fold.
    {%- endcomment -%}
    {% render 'legal-nav', current_url: policy.url %}

    <div class="main-page__footer">
      <p class="main-page__footer-text">{{ 'general.legal.contact_text' | t }}</p>
      {%- if settings.store_phone != blank -%}
        <a href="tel:{{ settings.store_phone | remove: '-' | remove: ' ' }}" class="btn btn--outline btn--sm">
          {% render 'icon', name: 'phone', size: 16 %}
          <span class="main-page__phone">{{ settings.store_phone }}</span>
        </a>
      {%- endif -%}
      {%- if settings.store_email != blank -%}
        <a href="mailto:{{ settings.store_email }}" class="btn btn--ghost btn--sm">
          {% render 'icon', name: 'mail', size: 16 %}
          <span class="main-page__phone">{{ settings.store_email }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>
