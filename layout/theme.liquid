{%- liquid
  assign rtl_locales = 'he,ar'
  assign is_rtl = false
  if rtl_locales contains request.locale.iso_code
    assign is_rtl = true
  endif
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" {% if is_rtl %}dir="rtl"{% else %}dir="ltr"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tagged' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="website">
    {%- if page_description -%}
      <meta property="og:description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- comment -%}
      Without a fallback the homepage and every ordinary page shares with no
      preview image at all — which on WhatsApp, where most of this shop's links
      get passed around, renders as a bare grey card. The square logo is the right
      fallback: the horizontal lockup gets letterboxed into unreadability at the
      1.91:1 crop Facebook and WhatsApp apply.
    {%- endcomment -%}
    {%- liquid
      assign share_image = page_image
      if share_image == blank
        assign share_image = settings.logo_square | default: settings.logo
      endif
    -%}
    {%- if share_image != blank -%}
      <meta property="og:image" content="http:{{ share_image | image_url: width: 1200 }}">
      <meta property="og:image:secure_url" content="https:{{ share_image | image_url: width: 1200 }}">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:image" content="https:{{ share_image | image_url: width: 1200 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- comment -%}
      Hebrew-first type, self-hosted on Shopify's CDN.

      Shopify's own font library only ships Basic Latin / Latin-1 / Latin Extended-A
      glyph ranges, so every font in it renders Hebrew as a system fallback. Assistant
      (UI) and Heebo (display) are bundled here as variable WOFF2 subsets instead —
      both are SIL Open Font License, so redistribution is permitted.

      A Hebrew visitor downloads only the two hebrew subsets, ~19KB total, and gets
      the full 300-900 weight range from them. The latin and latin-ext subsets load
      only when a page actually contains those characters (brand names, SKUs).

      Setting `use_shopify_fonts` switches to the theme's font pickers — useful for a
      Latin-only storefront, but it will break Hebrew rendering.
    {%- endcomment -%}
    {%- unless settings.use_shopify_fonts -%}
      {{ 'assistant-var-hebrew.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
      {{ 'heebo-var-hebrew.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.font_body | font_modify: 'weight', '700'
      assign body_font_medium = settings.font_body | font_modify: 'weight', '500'
      assign heading_font_heavy = settings.font_heading | font_modify: 'weight', '800'
    -%}

    <style>
      {%- unless settings.use_shopify_fonts -%}
        @font-face {
          font-family: 'Assistant';
          font-style: normal;
          font-weight: 300 800;
          font-display: swap;
          src: url({{ 'assistant-var-hebrew.woff2' | asset_url }}) format('woff2');
          unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;
        }
        @font-face {
          font-family: 'Assistant';
          font-style: normal;
          font-weight: 300 800;
          font-display: swap;
          src: url({{ 'assistant-var-latin.woff2' | asset_url }}) format('woff2');
          unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }
        @font-face {
          font-family: 'Assistant';
          font-style: normal;
          font-weight: 300 800;
          font-display: swap;
          src: url({{ 'assistant-var-latin-ext.woff2' | asset_url }}) format('woff2');
          unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
        }
        @font-face {
          font-family: 'Heebo';
          font-style: normal;
          font-weight: 300 900;
          font-display: swap;
          src: url({{ 'heebo-var-hebrew.woff2' | asset_url }}) format('woff2');
          unicode-range: U+0307-0308, U+0590-05FF, U+200C-2010, U+20AA, U+25CC, U+FB1D-FB4F;
        }
        @font-face {
          font-family: 'Heebo';
          font-style: normal;
          font-weight: 300 900;
          font-display: swap;
          src: url({{ 'heebo-var-latin.woff2' | asset_url }}) format('woff2');
          unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
        }
        @font-face {
          font-family: 'Heebo';
          font-style: normal;
          font-weight: 300 900;
          font-display: swap;
          src: url({{ 'heebo-var-latin-ext.woff2' | asset_url }}) format('woff2');
          unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
        }
      {%- endunless -%}

      {%- if settings.use_shopify_fonts -%}
        {{ settings.font_body | font_face: font_display: 'swap' }}
        {{ body_font_medium | font_face: font_display: 'swap' }}
        {{ body_font_bold | font_face: font_display: 'swap' }}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
        {%- if heading_font_heavy -%}
          {{ heading_font_heavy | font_face: font_display: 'swap' }}
        {%- endif -%}
      {%- endif -%}

      :root {
        {%- if settings.use_shopify_fonts -%}
          --font-body-family: {{ settings.font_body.family }}, "Assistant", "Segoe UI", Arial, sans-serif;
          --font-body-weight: {{ settings.font_body.weight | default: 400 }};
          --font-heading-family: {{ settings.font_heading.family }}, "Heebo", "Segoe UI", Arial, sans-serif;
          --font-heading-weight: {{ settings.font_heading.weight | default: 700 }};
        {%- else -%}
          --font-body-family: "Assistant", "Heebo", "Segoe UI", Arial, sans-serif;
          --font-body-weight: 400;
          --font-heading-family: "Heebo", "Assistant", "Segoe UI", Arial, sans-serif;
          --font-heading-weight: 800;
        {%- endif -%}
        --font-heading-scale: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
        --font-body-scale: {{ settings.body_scale | default: 100 | divided_by: 100.0 }};

        /* ---- Brand ---- */
        --color-accent: {{ settings.color_accent }};
        --color-accent-hover: {{ settings.color_accent_hover }};
        --color-accent-rgb: {{ settings.color_accent.rgb | replace: ' ', ', ' }};
        --color-accent-soft: {{ settings.color_accent | color_mix: '#ffffff', 8 }};
        --color-accent-tint: {{ settings.color_accent | color_mix: '#ffffff', 14 }};

        /* ---- Structure ---- */
        --color-ink: {{ settings.color_ink }};
        --color-ink-rgb: {{ settings.color_ink.rgb | replace: ' ', ', ' }};
        --color-ink-soft: {{ settings.color_ink | color_lighten: 7 }};
        --color-ink-line: {{ settings.color_ink | color_lighten: 16 }};

        /* ---- Surfaces ---- */
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_background }};
        --color-page: {{ settings.color_page }};
        --color-surface-alt: {{ settings.color_surface_alt }};
        --color-surface-sunken: {{ settings.color_surface_sunken }};

        /* ---- Text ---- */
        --color-text: {{ settings.color_text }};
        --color-text-rgb: {{ settings.color_text.rgb | replace: ' ', ', ' }};
        --color-text-muted: {{ settings.color_text_muted }};

        /* ---- Lines ---- */
        --color-border: {{ settings.color_border }};
        --color-border-strong: {{ settings.color_border_strong }};

        /* ---- Status ---- */
        --color-success: {{ settings.color_success }};
        --color-warning: {{ settings.color_warning }};
        --color-danger: {{ settings.color_danger }};
        --color-sale: {{ settings.color_sale }};
        --color-highlight: {{ settings.color_highlight }};
        --color-highlight-rgb: {{ settings.color_highlight.rgb | replace: ' ', ', ' }};
        --color-tile-bg: {{ settings.color_tile_bg | default: '#EFE9DF' }};

        --color-on-accent: #ffffff;
        --color-on-ink: #eef1f6;

        {%- case settings.corner_style -%}
          {%- when 'sharp' -%}
            --radius-sm: 0px;
            --radius-base: 0px;
            --radius-card: 0px;
            --radius-lg: 0px;
            --radius-pill: 4px;
          {%- when 'round' -%}
            --radius-sm: 10px;
            --radius-base: 14px;
            --radius-card: 22px;
            --radius-lg: 28px;
            --radius-pill: 999px;
          {%- else -%}
            --radius-sm: 8px;
            --radius-base: 10px;
            --radius-card: 16px;
            --radius-lg: 22px;
            --radius-pill: 999px;
        {%- endcase -%}

        --page-width: {{ settings.page_width | default: 1400 }}px;
        --page-gutter: clamp(1rem, 3vw, 2.5rem);

        --shadow-xs: 0 1px 2px rgba(var(--color-ink-rgb), 0.05);
        --shadow-sm: 0 1px 3px rgba(var(--color-ink-rgb), 0.06), 0 1px 2px rgba(var(--color-ink-rgb), 0.04);
        --shadow-md: 0 6px 16px -4px rgba(var(--color-ink-rgb), 0.10), 0 2px 6px -2px rgba(var(--color-ink-rgb), 0.06);
        --shadow-lg: 0 24px 48px -16px rgba(var(--color-ink-rgb), 0.24), 0 6px 16px -8px rgba(var(--color-ink-rgb), 0.10);

        /* Blueprint grid motif — the v2 decorative texture */
        --blueprint-line: rgba(var(--color-ink-rgb), 0.06);

        --duration-fast: 140ms;
        --duration-base: 240ms;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-spring: cubic-bezier(0.34, 1.4, 0.64, 1);
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

    {% render 'structured-data' %}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      {%- if settings.enable_animations == false -%}
      document.documentElement.classList.add('no-animations');
      {%- endif -%}
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
        search_url: '{{ routes.search_url }}'
      };
      window.cartStrings = {
        error: {{ 'cart.errors.general_error' | t | json }},
        quantityError: {{ 'cart.errors.quantity_error' | t: quantity: '[quantity]' | json }},
        added: {{ 'products.product.added' | t | json }}
      };
      window.themeSettings = {
        cartType: {{ settings.cart_type | json }},
        predictiveSearch: {{ settings.predictive_search_enabled | json }},
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- comment -%} Floating contact dock — mobile-first, real store details {%- endcomment -%}
    {%- if settings.show_contact_dock -%}
      {% render 'contact-dock' %}
    {%- endif -%}

    {%- comment -%}
      In-theme accessibility widget (replaces the Sense RTL app's block).
      Floats at inline-start, opposite the contact dock.
    {%- endcomment -%}
    {%- if settings.a11y_enabled -%}
      {% render 'accessibility-widget' %}
    {%- endif -%}

    {%- comment -%}
      Marker read by assets/recently-viewed.js. Lives in the layout so the
      product section can be re-authored without breaking the history feature.
    {%- endcomment -%}
    {%- if request.page_type == 'product' and product -%}
      <span hidden data-product-handle="{{ product.handle }}"></span>
    {%- endif -%}

    <div class="toast-region" aria-live="polite" aria-atomic="true" data-toast-region></div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'general.accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'general.accessibility.link_opens_new_tab' | t }}</li>
    </ul>
  </body>
</html>
