{%- comment -%}
  Renders a quantity selector (the <quantity-input> element in global.js wires
  the -/+ buttons to the native number input and re-fires `change`).

  Usage: {% render 'quantity-input', id: 'Quantity-1', name: 'quantity', value: 1, min: 1, max: 10, small: true, product_title: 'X', line: 2 %}
  Params:
    id            {String}  input id, so an external <label for> can reach it
    name          {String}  input name (default "quantity")
    value         {Number}  starting value (default 1)
    min           {Number}  minimum (default 1)
    max           {Number}  maximum — omit for unlimited
    small         {Boolean} compact variant for cart lines
    line          {Number}  cart line index, exposed as data-line
    product_title {String}  used in the buttons' accessible labels
  Component styles: .qty / .qty__btn / .qty__input in assets/base.css.
{%- endcomment -%}
{%- liquid
  assign qty_value = value | default: 1
  assign qty_min = min | default: 1
  assign input_name = name | default: 'quantity'
  assign title_for_a11y = product_title | default: ''
-%}
<quantity-input class="qty{% if small %} qty--sm{% endif %}" {% if line %}data-line="{{ line }}"{% endif %}>
  <button
    type="button"
    name="minus"
    class="qty__btn"
    aria-label="{{ 'general.accessibility.decrease_quantity' | t: product: title_for_a11y }}"
  >
    {% render 'icon', name: 'minus', size: 16 %}
  </button>
  <input
    type="number"
    class="qty__input"
    {% if id %}id="{{ id }}"{% endif %}
    name="{{ input_name }}"
    value="{{ qty_value }}"
    min="{{ qty_min }}"
    {% if max %}max="{{ max }}"{% endif %}
    step="1"
    inputmode="numeric"
    pattern="[0-9]*"
    autocomplete="off"
    aria-label="{{ 'products.product.quantity_label' | t }}"
  >
  <button
    type="button"
    name="plus"
    class="qty__btn"
    aria-label="{{ 'general.accessibility.increase_quantity' | t: product: title_for_a11y }}"
  >
    {% render 'icon', name: 'plus', size: 16 %}
  </button>
</quantity-input>
